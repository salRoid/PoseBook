node_modules/

# macOS
.DS_Store

# Build output of the RIG (poses/ → dist/svg). Regenerated by `npm run build`;
# it is not what Health consumes — frames/corpus is.
dist/

# The staging area for strips you have generated but not yet ingested, and the
# `done/` archive of every strip ever ingested (~560 MB of source PNGs).
# `npm run ingest-frames` produces frames/corpus, which IS published — the raw
# drops are not. Same rule as Foodsum's inbox/, and for the same reason: a
# repo that is served over jsDelivr must stay light enough to clone.
# Keep the folder itself so the workflow stays discoverable.
frames/inbox/*
!frames/inbox/README.md

# The RIG's body-part sources, same category as frames/inbox: raw generated
# PNGs (parts/inbox) and the 46 colour studies (parts/color-assets). They are
# how the parts were MADE; `parts/manifest.json` and the traced vectors are the
# result, and the result is what anything downstream reads. 23.5 MB.
parts/inbox/
parts/color-assets/

# Per-tier holding pens for strips mid-generation. Working state, not corpus.
frames/staging/

# Snapshots taken before a destructive re-ingest. Local safety nets, not
# history — git is the history.
frames/backups/
frames/corpus-stale-backup-*/

# Review verdicts and the gallery are a LOCAL working surface: review.db is a
# SQLite file that every reviewer would conflict on, and reviews/ is generated
# from it by `npm run gallery`.
frames/review.db
reviews/
